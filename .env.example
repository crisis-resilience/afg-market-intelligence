# Copy this file to .env and fill in your values.
#
#   Local development  ->  see README.md "Quick start"
#   Production VM      ->  see docs/VM_DEPLOYMENT.md section 4
#
# .env is excluded from git AND from the Docker build context (.dockerignore).
# Keep it that way — it holds the database password and the Comtrade key.

# ── Required everywhere ──────────────────────────────────────────────────────

# UN Comtrade API subscription key.
# Obtain from: https://unstats.un.org/wiki/display/comtrade/UN+Comtrade+API
# No key is needed for World Bank or WITS — those are public endpoints.
COMTRADE_API_KEY=your_api_key_here

# PostgreSQL connection string.
#   local (running Postgres via docker-compose.yml):
#     postgresql://postgres:postgres@localhost:5432/afg_market
#   production (docker-compose.prod.yml): the host is `db`, the compose service
#     name — the API reaches Postgres over the internal network, not localhost:
#     postgresql://postgres:<POSTGRES_PASSWORD>@db:5432/afg_market
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afg_market

# Password for the `postgres` user in the Docker Postgres container.
# Production: generate a real one — `openssl rand -base64 32` — and make sure
# it matches the password inside DATABASE_URL above.
POSTGRES_PASSWORD=postgres


# ── Production only (docker-compose.prod.yml) ────────────────────────────────

# How Caddy serves the site.
#   https://afg-market.example.org  -> real, auto-renewing Let's Encrypt cert
#   :80                             -> plain HTTP, no certificate, DEMO ONLY
# Let's Encrypt cannot issue for a bare IP, so with only the VM's IP you must
# either point a domain at it or accept :80. See docs/VM_DEPLOYMENT.md §5.
# SITE_ADDRESS=:80

# Comma-separated browser origins allowed to call the API cross-origin.
# Caddy serves the API and the UI from ONE origin in production, so this
# normally needs nothing at all. Defaults to http://localhost:3000 (not "*").
# CORS_ORIGINS=https://afg-market.example.org

# LOG_LEVEL=INFO

# Where the ETL writes its log file. Defaults to ./etl_run.log, which is not
# writable inside the container (it runs unprivileged against a root-owned
# /app), so containerised runs log to stdout only — which is what
# `docker compose logs` reads. Set this to a bind-mounted, writable directory
# if you want file logs in production too.
# ETL_LOG_FILE=/var/log/afg-market/etl_run.log

# ── Set automatically — do not fill these in ─────────────────────────────────
# deploy/vm/deploy.sh rewrites BACKEND_IMAGE and FRONTEND_IMAGE in .env on every
# deploy, pinning the exact commit currently in production. Editing them by hand
# will be overwritten on the next deploy.
# BACKEND_IMAGE=ghcr.io/crisis-resilience/afg-market-intelligence/backend:sha-...
# FRONTEND_IMAGE=ghcr.io/crisis-resilience/afg-market-intelligence/frontend:sha-...


# ── Local test runs (optional) ───────────────────────────────────────────────
# Enables the Postgres-backed test suites (etl/tests/test_load.py,
# test_pipeline_integration.py, test_verify.py). Without it they skip.
# Start the throwaway DB first: docker compose up -d db_test
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/afg_market_test
